<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#D32F2F"
        app:title="Jersey Detail"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_product_detail"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:contentDescription="Jersey Image" />

            <TextView
                android:id="@+id/tv_name_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jersey Name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tv_club_season_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Club - Season"
                android:textSize="18sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_price_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$99.99"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Size"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <RadioGroup
                android:id="@+id/radio_group_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <RadioButton android:id="@+id/rb_s" android:text="S" android:layout_marginEnd="16dp" />
                <RadioButton android:id="@+id/rb_m" android:text="M" android:checked="true" android:layout_marginEnd="16dp" />
                <RadioButton android:id="@+id/rb_l" android:text="L" android:layout_marginEnd="16dp" />
                <RadioButton android:id="@+id/rb_xl" android:text="XL" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_add_to_cart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add to Cart"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btn_view_cart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Cart"
                android:backgroundTint="#212121"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>